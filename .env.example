# ============================================================================
# HaloLink — environment template. Copy to .env and fill in.
#   cp .env.example .env
# ============================================================================

# ---- Runtime ----
APP_ENV=development            # development | staging | production
APP_NAME=halolink-api
HTTP_HOST=0.0.0.0
HTTP_PORT=8080                 # ConnectRPC + REST gateway
LOG_LEVEL=debug                # debug | info | warn | error
LOG_FORMAT=text                # text (dev) | json (prod)

# Public base URLs (used in emails, booking links, OAuth callbacks)
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=halolink
POSTGRES_PASSWORD=halolink
POSTGRES_DB=halolink
POSTGRES_SSLMODE=disable
# Full DSN (overrides the parts above if set)
DATABASE_URL=postgres://halolink:halolink@localhost:5432/halolink?sslmode=disable

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
# 32+ byte random secret. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-value-please
SESSION_TTL=720h               # 30 days
API_KEY_PREFIX=hl_

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="HaloLink <noreply@halolink.dev>"
# Local dev uses Mailpit SMTP instead of Resend when RESEND_API_KEY is empty
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- Google Calendar OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/oauth/google/callback

# ---- Microsoft / Outlook Calendar OAuth ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URL=http://localhost:8080/v1/oauth/microsoft/callback

# ---- Observability (OpenTelemetry) ----
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # Jaeger OTLP/HTTP
OTEL_SERVICE_NAME=halolink-api
OTEL_TRACES_SAMPLER_ARG=1.0

# ---- Rate limiting (defaults; per-route overrides in code) ----
RATELIMIT_PUBLIC_RPS=10
RATELIMIT_PUBLIC_BURST=20
