{
  "name": "halomail",
  "version": "0.0.1",
  "private": true,
  "description": "HaloMail — API-first scheduling + contact-form platform",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "lint": "pnpm -r --if-present lint",
    "web": "pnpm --filter @halomail/web",
    "docs": "pnpm --filter @halomail/docs",
    "sdk": "pnpm --filter @halomail/sdk",
    "proto": "buf generate",
    "proto:lint": "buf lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
